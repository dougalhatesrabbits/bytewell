<!DOCTYPE html>
<html lang="en-GB">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Bytewell IT Support | Liverpool</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;500;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="bytewell.css">
</head>

<body>
  <header>
    <div class="wrap">
      <a class="logo" href="#top">Byte<span>well</span></a>
      <nav aria-label="Main"><a class="hide" href="#services">Services</a><a class="hide" href="#why">Why Bytewell</a><a
          href="#pricing">Pricing</a><a href="#faq">FAQ</a><a class="btn btn-sun" href="#contact"
          style="padding:8px 16px">Get a quote</a></nav>
    </div>
  </header>

  <main id="top">
    <div class="hero">
      <div class="wrap grid">
        <div>
          <h1>Tech that just works.</h1>
          <p class="lead">Friendly IT support for Liverpool homes and small businesses. Slow laptop? Dodgy Wi-Fi? Office
            network playing up? We'll get it sorted, properly, and explain it in plain English.</p>
          <div class="row"><a class="btn btn-sun" href="#contact">Book a call</a><a class="btn btn-line"
              href="#pricing">See prices</a></div>
          <small>Same-day replies. Remote and on-site support. Clear prices upfront.</small>
        </div>
        <aside class="ticket" aria-label="Example job">
          <b>Job #0142: Wi-Fi drops out</b>
          <div><span>Diagnosed</span><span class="done">Done</span></div>
          <div><span>Router moved and reconfigured</span><span class="done">Done</span></div>
          <div><span>Explained in plain English</span><span class="done">Done</span></div>
          <div class="stamp">Sorted. Properly.</div>
        </aside>
      </div>
    </div>

    <section id="services">
      <div class="wrap">
        <h2>How we can help</h2>
        <div class="tabs" role="tablist" aria-label="Choose customer type">
          <button type="button" role="tab" id="t-home" aria-selected="true" aria-controls="p-home" data-tab="home">For home</button>
          <button type="button" role="tab" id="t-biz" aria-selected="false" aria-controls="p-biz" data-tab="biz">For business</button>
        </div>
        <div class="panel" id="p-home" role="tabpanel" aria-labelledby="t-home" data-panel="home">
          <p><strong>Tech trouble at home? We'll get it sorted.</strong></p>
          <ul class="services">
            <li><strong>Computer and laptop repair</strong><span>Slow, virus-ridden, or won't start.</span></li>
            <li><strong>Wi-Fi and broadband help</strong><span>Better coverage in every room.</span></li>
            <li><strong>New device setup</strong><span>Phones, tablets, laptops, printers, smart TVs.</span></li>
            <li><strong>Data backup and recovery</strong><span>Keep your photos and documents safe.</span></li>
            <li><strong>Online safety</strong><span>Virus removal, scam advice, account protection.</span></li>
          </ul>
          <a class="btn btn-sun" href="#contact" data-topic="Home visit">Book a home visit</a>
        </div>
        <div class="panel" id="p-biz" role="tabpanel" aria-labelledby="t-biz" data-panel="biz" hidden>
          <p><strong>Reliable IT, so your team can get on with the job.</strong></p>
          <ul class="services">
            <li><strong>Network and Wi-Fi setup</strong><span>Secure, reliable connections.</span></li>
            <li><strong>Email and Microsoft 365 / Google Workspace</strong><span>Set up and supported.</span></li>
            <li><strong>Backups and data security</strong><span>Protection against data loss and ransomware.</span></li>
            <li><strong>Ongoing IT support</strong><span>Fast help when something breaks.</span></li>
            <li><strong>New starter setup</strong><span>Laptops and accounts ready on day one.</span></li>
          </ul>
          <a class="btn btn-sun" href="#contact" data-topic="Business quote">Get a business quote</a>
        </div>
      </div>
    </section>

    <section id="why" class="why">
      <div class="wrap">
        <h2>Why choose Bytewell</h2>
        <ul>
          <li>
            <h3>Local and personal</h3>
            <p>A real person from Liverpool, not a call centre.</p>
          </li>
          <li>
            <h3>Plain English, always</h3>
            <p>No jargon, and no question is a daft one.</p>
          </li>
          <li>
            <h3>Honest advice</h3>
            <p>We only recommend what you actually need.</p>
          </li>
          <li>
            <h3>Clear prices, no surprises</h3>
            <p>You'll know the cost before we start.</p>
          </li>
          <li>
            <h3>Fast and reliable</h3>
            <p>Same-day replies and remote fixes where possible.</p>
          </li>
          <li>
            <h3>Your data comes first</h3>
            <p>We back up before making big changes.</p>
          </li>
        </ul>
      </div>
    </section>

    <section id="pricing">
      <div class="wrap">
        <h2>Pricing at a glance</h2>
        <div class="tabs" role="tablist" aria-label="Pricing type">
          <button type="button" role="tab" id="pt-home" aria-selected="true" aria-controls="pp-home" data-tab="home">Home</button>
          <button type="button" role="tab" id="pt-biz" aria-selected="false" aria-controls="pp-biz" data-tab="biz">Business</button>
        </div>
        <div class="panel scroll" id="pp-home" role="tabpanel" aria-labelledby="pt-home" data-panel="home">
          <table>
            <thead>
              <tr>
                <th>Service</th>
                <th>Price</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Remote support session (up to 30 mins)</td>
                <td>£25</td>
              </tr>
              <tr>
                <td>Home visit, first hour</td>
                <td>£45</td>
              </tr>
              <tr>
                <td>Additional time (per hour)</td>
                <td>£35</td>
              </tr>
              <tr>
                <td>Computer health check and tune-up</td>
                <td>£49</td>
              </tr>
              <tr>
                <td>New device setup (per device)</td>
                <td>£35</td>
              </tr>
              <tr>
                <td>Virus and malware removal</td>
                <td>From £60</td>
              </tr>
              <tr>
                <td>Wi-Fi improvement and setup</td>
                <td>From £55</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="panel scroll" id="pp-biz" role="tabpanel" aria-labelledby="pt-biz" data-panel="biz" hidden>
          <table>
            <thead>
              <tr>
                <th>Plan</th>
                <th>Price</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Pay as you go (per hour)</td>
                <td>£50</td>
              </tr>
              <tr>
                <td>Essential plan: remote support and monthly health check</td>
                <td>£75 / month</td>
              </tr>
              <tr>
                <td>Standard plan: adds on-site visits and priority response</td>
                <td>£150 / month</td>
              </tr>
              <tr>
                <td>New starter setup (per person)</td>
                <td>£60</td>
              </tr>
              <tr>
                <td>Network or Wi-Fi setup</td>
                <td>Quote on request</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">Example prices. Excludes VAT where applicable. Larger projects are quoted individually.</p>
      </div>
    </section>

    <section id="faq" class="why">
      <div class="wrap" style="max-width:820px">
        <h2>Quick answers</h2>
        <details>
          <summary>Where do you cover?</summary>
          <p>Liverpool and surrounding areas, including the Wirral, Sefton, and Knowsley. Not sure if you're in range?
            Just ask.</p>
        </details>
        <details>
          <summary>How quickly can you get to me?</summary>
          <p>We reply the same day and can often visit within 24 to 48 hours. Many issues can be fixed remotely, which
            is usually even quicker.</p>
        </details>
        <details>
          <summary>Do you offer remote support?</summary>
          <p>Yes. For software problems, email issues, and many computer faults, we can fix things over a secure remote
            connection.</p>
        </details>
        <details>
          <summary>How much do you charge?</summary>
          <p>You get a clear price before any work begins. Home customers can choose a fixed price or hourly rate.
            Businesses can choose pay as you go or a monthly plan.</p>
        </details>
        <details>
          <summary>What if you can't fix it?</summary>
          <p>Then you don't pay for the repair. We'll tell you honestly if something isn't worth fixing and talk you
            through your options.</p>
        </details>
        <details>
          <summary>Will my data be safe?</summary>
          <p>Yes. We back up important data before significant changes and never access anything we don't need to.</p>
        </details>
        <details>
          <summary>Do you support Windows and Mac?</summary>
          <p>Yes, plus iPhones, iPads, Android devices, printers, routers, and smart home gear.</p>
        </details>
        <details>
          <summary>Is it one-off help or ongoing support only?</summary>
          <p>Both. There's no obligation to sign up for anything.</p>
        </details>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="wrap grid">
        <div>
          <h2>Ready to get it sorted?</h2>
          <p>Send us a message and we'll get back to you the same day.</p>
          <p>Phone: [Phone number]<br>Email: email@djbrooke.uk</p>
          <p><strong>Sorted. Properly.</strong></p>
        </div>
        <div>
          <form id="f" action="form-process.php" method="POST">
            <label>Your name<input id="n" type="text" name="name" autocomplete="name" required></label>
            <label>Email or phone<input id="e" type="email" name="email" autocomplete="email" required></label>
            <label>What do you need?<select id="topic">
                <option>Home repair or support</option>
                <option>Home visit</option>
                <option>Business quote</option>
                <option>Ongoing business support</option>
                <option>Something else</option>
              </select></label>
            <label>Tell us a bit more<textarea id="m" rows="3" name="message"></textarea></label>
            <p id="err" role="alert" style="color:var(--sun);margin:0" hidden>Add your name and a way to reach you.</p>
            <button class="btn btn-sun" type="submit">Send message</button>
          </form>
          <div class="ok" id="ok" role="status" hidden>Thanks, message received. We'll reply the same day. (This is a
            demo form: nothing has been sent.)</div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">Bytewell IT Support &bull; Liverpool, UK &bull; [Phone] &bull; email@djbrooke.uk &bull; Privacy
      Policy &bull; Terms &bull; [Company number]</div>
  </footer>

  <script>
    document.querySelectorAll('.tabs').forEach(function (tabs) {
      var sec = tabs.parentElement;
      tabs.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        tabs.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-selected', x === b) });
        sec.querySelectorAll('.panel').forEach(function (p) { p.hidden = p.dataset.panel !== b.dataset.tab });
      });
    });
    document.querySelectorAll('[data-topic]').forEach(function (a) {
      a.addEventListener('click', function () { document.getElementById('topic').value = a.dataset.topic });
    });
    document.getElementById('f').addEventListener('submit', function (e) {
      e.preventDefault();
      var bad = !document.getElementById('n').value.trim() || !document.getElementById('e').value.trim();
      document.getElementById('err').hidden = !bad;
      if (!bad) { this.hidden = true; document.getElementById('ok').hidden = false }
    });
  </script>
</body>

</html>